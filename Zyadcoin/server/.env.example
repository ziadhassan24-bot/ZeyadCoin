# Groq API key — get one for free at https://console.groq.com/keys
# Copy this file to ".env" and paste your key. NEVER commit .env to git.
# This key lives ONLY on the server. The browser/frontend never sees it.
GROQ_API_KEY=your_groq_api_key_here

# Private key of the TRUSTED SIGNER wallet (0x12d46659425ABF0554C59baad37Aa21c436493AD).
# Signs EIP-712 claims that authorize the ZydFaucet to release ZYD. It MUST be
# that exact wallet's key, or the faucet rejects every claim. Server-only secret —
# never commit it and never expose it to the frontend. (No value here on purpose.)
SIGNER_PRIVATE_KEY=

# Optional: override the API port. Locally this defaults to 3001. On Render
# you do NOT need to set this — the platform provides PORT automatically.
PORT=3001

# Production only: the deployed frontend origin(s) allowed to call this API
# (CORS). Comma-separated if more than one. Example:
# FRONTEND_URL=https://zyadcoin.vercel.app
FRONTEND_URL=
